  "components": {
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Положительный идентификатор сохранённой записи.",
        "schema": {"type": "integer", "minimum": 1}
      }
    },
    "requestBodies": {
      "SaveDto": {
        "required": true,
        "description": "DTO для сохранения и необязательные параметры исходного запроса.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["dto"],
              "properties": {
                "dto": {
                  "type": "object",
                  "description": "DTO соответствующего ресурса."
                },
                "requestParameters": {
                  "type": "object",
                  "description": "Параметры запроса, по которым получен ответ.",
                  "additionalProperties": true
                }
              }
            },
            "example": {
              "dto": {
                "data": {}
              },
              "requestParameters": {
                "inn": "7707083893"
              }
            }
          }
        }
      }
    },
    "responses": {
      "Created": {
        "description": "Запись сохранена.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "Некорректный идентификатор или тело запроса."
      },
      "NotFound": {
        "description": "Неизвестный ресурс или сохранённая запись не найдена."
      },
      "MethodNotAllowed": {
        "description": "Поддерживаются только методы GET и POST."
      },
      "ServerError": {
        "description": "Ошибка при работе с хранилищем."
      }
    },
    "schemas": {
      "LegalCasesDto": {"type": "object", "description": "DTO арбитражных дел.", "additionalProperties": true},
      "BankDto": {"type": "object", "description": "DTO сведений о банке.", "additionalProperties": true},
      "ContractsDto": {"type": "object", "description": "DTO сведений о контрактах.", "additionalProperties": true},
      "EntrepreneurDto": {"type": "object", "description": "DTO сведений об индивидуальном предпринимателе.", "additionalProperties": true},
      "CompanyDto": {"type": "object", "description": "DTO сведений о компании.", "additionalProperties": true},
      "TimelineDto": {"type": "object", "description": "DTO истории изменений.", "additionalProperties": true},
      "ReliabilityDto": {"type": "object", "description": "DTO оценки надёжности.", "additionalProperties": true},
      "PersonDto": {"type": "object", "description": "DTO сведений о физическом лице.", "additionalProperties": true},
      "SearchDto": {"type": "object", "description": "DTO результатов поиска.", "additionalProperties": true},
      "InspectionsDto": {"type": "object", "description": "DTO сведений о проверках.", "additionalProperties": true},
      "BankruptcyMessagesDto": {"type": "object", "description": "DTO сообщений о банкротстве.", "additionalProperties": true},
      "FedresursDto": {"type": "object", "description": "DTO сообщений Федресурса.", "additionalProperties": true},
      "FinancesDto": {"type": "object", "description": "DTO финансовой отчётности.", "additionalProperties": true},
      "EnforcementsDto": {"type": "object", "description": "DTO исполнительных производств.", "additionalProperties": true}
    }
  }
}
